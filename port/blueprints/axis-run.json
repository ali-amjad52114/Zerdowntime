{
  "identifier": "mendAxisRun",
  "title": "Mend Axis Run",
  "icon": "Data",
  "description": "One independently retryable X, Y, or Z execution for exactly one target run.",
  "schema": {
    "properties": {
      "axis": { "title": "Axis", "type": "string", "enum": ["X", "Y", "Z"] },
      "status": { "title": "Status", "type": "string", "enum": ["queued", "running", "succeeded", "failed", "retry_pending", "healing_pending", "unavailable"] },
      "provider": { "title": "Provider", "type": "string" },
      "source_execution_id": { "title": "Source execution ID", "type": "string" },
      "healing_request_id": { "title": "Healing request ID", "type": "string" },
      "retry_count": { "title": "Retry count", "type": "number" },
      "max_retries": { "title": "Maximum retries", "type": "number" },
      "retry_history": { "title": "Retry history", "type": "array", "items": { "type": "object" } },
      "last_retry_port_run_id": { "title": "Last retry Port run ID", "type": "string" },
      "failure_code": { "title": "Failure code", "type": "string" },
      "failure_message": { "title": "Failure message", "type": "string" },
      "record_count": { "title": "Record count", "type": "number" },
      "validation_status": { "title": "Validation status", "type": "string", "enum": ["pending", "pass", "fail", "not_applicable"] },
      "evidence_url": { "title": "Evidence URL", "type": "string", "format": "url" },
      "updated_at": { "title": "Updated at", "type": "string", "format": "date-time" },
      "contract_version": { "title": "Contract version", "type": "string" }
    },
    "required": ["axis", "status", "provider", "retry_count", "max_retries", "retry_history", "record_count", "validation_status", "updated_at", "contract_version"]
  },
  "mirrorProperties": {}, "calculationProperties": {}, "aggregationProperties": {},
  "relations": { "target_run": { "title": "Target run", "target": "mendTargetRun", "required": true, "many": false } }
}
