# Bright Data CLI reads this variable in headless/agent environments.
BRIGHTDATA_API_KEY=replace_me

# Filled after `npm run brightdata:create` succeeds.
SCRAPER_STUDIO_COLLECTOR_ID=
SCRAPER_STUDIO_TARGET_URL=https://example.com
SCRAPER_STUDIO_EXPECTED_FIELDS=page_title,heading,description,source_url

# Mend X-axis live Bright Data source (Beam Therapeutics pipeline).
MEND_X_COLLECTOR_ID=
MEND_X_TARGET_URL=https://beamtx.com/pipeline/

# Local SigNoz defaults. For SigNoz Cloud, replace the endpoint and put the
# ingestion key in ignored .env.local as: signoz-ingestion-key=<value>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=zero-downtime-fixture
OTEL_ENVIRONMENT=local

# SigNoz Cloud MCP access. SIGNOZ_URL is the workspace URL shown in the
# browser (for example, https://your-workspace.signoz.cloud), not the MCP URL.
# Keep the real API key only in ignored .env.local or your user environment.
SIGNOZ_MCP_URL=https://mcp.us2.signoz.cloud/mcp
SIGNOZ_URL=
SIGNOZ_API_KEY=

# Port machine credentials are needed only for `npm run port:sync -- --live`.
# Keep real values in ignored .env.local or GitHub Actions secrets.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.port.io
PORT_GITHUB_ORG=
PORT_GITHUB_REPO=

# Meridian — the controlled break surface (mend/). MEND_MERIDIAN_URL is the
# deployed origin; leave it unset to read the committed mend/versions/ tree
# instead, which needs no network and no deployment.
MEND_MERIDIAN_URL=
MEND_MERIDIAN_VERSION=v1

# The control room switch that flips which version /pipeline serves.
# EDGE_CONFIG is injected by Vercel when an Edge Config store is connected.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
CONTROL_TOKEN=
