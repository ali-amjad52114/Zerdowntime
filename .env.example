# Bright Data CLI reads this variable in headless/agent environments.
BRIGHTDATA_API_KEY=replace_me

# Filled after `npm run brightdata:create` succeeds.
SCRAPER_STUDIO_COLLECTOR_ID=
SCRAPER_STUDIO_TARGET_URL=https://example.com
SCRAPER_STUDIO_EXPECTED_FIELDS=page_title,heading,description,source_url

# Local SigNoz defaults. For SigNoz Cloud, replace the endpoint and put the
# ingestion key in ignored .env.local as: signoz-ingestion-key=<value>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=zero-downtime-fixture
OTEL_ENVIRONMENT=local

# Port machine credentials are needed only for `npm run port:sync -- --live`.
# Keep real values in ignored .env.local or GitHub Actions secrets.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.port.io
PORT_GITHUB_ORG=
PORT_GITHUB_REPO=
